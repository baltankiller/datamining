      "values": "r01~r17",
      "definition": "지역명은 통합자료의 region_name 또는 코드북 확인",
      "role": "predictor"
    },
    {
      "variable": "income_band6",
      "meaning": "가구 월평균 소득",
      "values": "100만원 미만 / 100~199 / 200~299 / 300~399 / 400~599 / 600만원 이상",
      "definition": "명목형 6구간. 2019~2020년의 다른 구간을 정확히 묶어 통일",
      "role": "predictor"
    },
    {
      "variable": "pc_access",
      "meaning": "필요시 PC 이용 가능 여부",
      "values": "no / yes",
      "definition": "데스크톱·노트북 중 하나 이상 이용 가능",
      "role": "predictor"
    },
    {
      "variable": "smartphone_access",
      "meaning": "스마트폰 이용 가능 여부",
      "values": "no / yes",
      "definition": "휴대전화 응답 슬롯 중 하나라도 스마트폰",
      "role": "predictor"
    },
    {
      "variable": "self_efficacy_mean3",
      "meaning": "디지털기기 이용 효능감",
      "values": "1~4점",
      "definition": "자신감 및 사용법 습득 3문항의 완전응답 평균",
      "role": "predictor"
    },
    {
      "variable": "training_experience",
      "meaning": "정보화교육 참여 경험",
      "values": "no / yes",
      "definition": "Q30=1은 yes, Q30=2~4는 no. 2024~2025년만 확인",
      "role": "predictor"
    },
    {
      "variable": "sex",
      "meaning": "성별",
      "values": "male / female",
      "definition": "ADQ2",
      "role": "predictor"
    },
    {
      "variable": "school_level",
      "meaning": "최종 학력",
      "values": "초등졸 이하 / 중졸 / 고졸 / 대졸 이상",
      "definition": "ADQ4. 네 가지 명목 범주",
      "role": "predictor"
    },
    {
      "variable": "residence_type",
      "meaning": "거주지 형태",
      "values": "dong / eup_myeon",
      "definition": "ADQ103. 동 / 읍면",
      "role": "predictor"
    },
    {
      "variable": "risk_class",
      "meaning": "연구용 소외 등급",
      "values": "at_risk / general",
      "definition": "14문항 평균 2.5 미만은 소외. 공식 NIA 등급 아님",
      "role": "target"
    }
