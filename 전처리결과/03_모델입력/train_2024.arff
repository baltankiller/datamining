% Research proxy: mean of 14 ability items < 2.5. Not an official NIA grade.
% Target is last. IDs, weights, year and all target components are excluded.
@relation nia_older60_risk_proxy

@attribute age_band {'60s','70plus'}
@attribute region {'r01','r02','r03','r04','r05','r06','r07','r08','r09','r10','r11','r12','r13','r14','r15','r16','r17'}
@attribute income_band6 {'lt100','100_199','200_299','300_399','400_599','600plus'}
@attribute pc_access {'no','yes'}
@attribute smartphone_access {'no','yes'}
@attribute self_efficacy_mean3 numeric
@attribute training_experience {'no','yes'}
@attribute sex {'male','female'}
@attribute school_level {'primary_or_less','middle','high','college_plus'}
@attribute residence_type {'dong','eup_myeon'}
@attribute risk_class {'at_risk','general'}

