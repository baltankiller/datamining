% Source: 2025 NIA Digital Divide Survey, 7) elderly workbook (2300 rows)
% risk_class: mean of Q8_1..Q8_9, Q9_1..Q9_9 (digital competency index) < 2.5 -> risk
% confidence: mean of Q22_1..Q22_3 / Q6~Q9 excluded from predictors / no weights
@RELATION elderly_digital_divide_2025

@ATTRIBUTE age_group {50s,60s,70plus}
@ATTRIBUTE region {Seoul,Busan,Daegu,Incheon,Gwangju,Daejeon,Ulsan,Sejong,Gyeonggi,Gangwon,Chungbuk,Chungnam,Jeonbuk,Jeonnam,Gyeongbuk,Gyeongnam,Jeju}
@ATTRIBUTE area_type {dong,eupmyeon}
@ATTRIBUTE income {under200,200to399,400to599,600plus}
@ATTRIBUTE education {elementary,middle,high,college}
@ATTRIBUTE sex {male,female}
@ATTRIBUTE pc_available {yes,no}
@ATTRIBUTE smartphone {yes,no}
@ATTRIBUTE confidence NUMERIC
@ATTRIBUTE training_experience {yes,no}
@ATTRIBUTE risk_class {risk,nonrisk}

@DATA
